+++ b/scripts/flyway-migrate.sh
@@ -0,0 +1,47 @@
+#!/usr/bin/env bash
+# Corre Flyway migrate contra el schema `ventas`.
+# Preferencia: FLYWAY_CMD (CLI local) → si no, imagen Docker flyway/flyway.
+set -euo pipefail
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+
+FLYWAY_URL="${FLYWAY_URL:-jdbc:postgresql://localhost:5433/ventas360}"
+FLYWAY_USER="${FLYWAY_USER:-ventas_migrator}"
+FLYWAY_PASSWORD="${FLYWAY_PASSWORD:-ventas_migrator_dev}"
+FLYWAY_IMAGE="${FLYWAY_IMAGE:-flyway/flyway:11.8.2}"
+
+echo "→ Flyway migrate (${FLYWAY_USER} → schema ventas)"
+
+if [[ -n "${FLYWAY_CMD:-}" ]]; then
+  # CLI local: locations relativos al dir flyway/
+  (
+    cd "${ROOT}/flyway"
+    "${FLYWAY_CMD}" \
+      -configFiles=conf/flyway.conf \
+      -url="${FLYWAY_URL}" \
+      -user="${FLYWAY_USER}" \
+      -password="${FLYWAY_PASSWORD}" \
+      migrate
+  )
+elif command -v docker >/dev/null 2>&1; then
+  DOCKER_OPTS=(--rm)
+  URL="${FLYWAY_URL}"
+  if docker info 2>/dev/null | grep -qi linux; then
+    DOCKER_OPTS+=(--network host)
+    URL="${FLYWAY_URL_LINUX:-jdbc:postgresql://localhost:5433/ventas360}"
+  fi
+  docker run "${DOCKER_OPTS[@]}" \
+    -v "${ROOT}/flyway/sql:/flyway/sql:ro" \
+    -v "${ROOT}/flyway/conf:/flyway/conf:ro" \
+    "${FLYWAY_IMAGE}" \
+    -configFiles=/flyway/conf/flyway.conf \
+    -url="${URL}" \
+    -user="${FLYWAY_USER}" \
+    -password="${FLYWAY_PASSWORD}" \
+    migrate
+else
+  echo "Definí FLYWAY_CMD=/ruta/a/flyway o instalá Docker." >&2
+  exit 1
+fi
+
+echo "✓ Flyway OK — historial en ventas.flyway_schema_history"
diff --git a/scripts/sql/01_bootstrap_roles_ventas.sql.template b/scripts/sql/01_bootstrap_roles_ventas.sql.template
new file mode 100644
index 0000000..8b7eeea
--- /dev/null
+++ b/scripts/sql/01_bootstrap_roles_ventas.sql.template
@@ -0,0 +1,61 @@
+-- Bootstrap de roles Postgres para el producto Ventas.
+--
+-- Ejecutar UNA VEZ por instancia (stage / prod / local), conectado como
+-- superuser o dueño de la DB (en Docker local: user `ventas360`).
+--
+-- Uso típico (vía scripts/bootstrap-roles.sh, que sustituye placeholders):
+--   DB_NAME=ventas360 \
+--   VENTAS_MIGRATOR_PASSWORD='...' \
+--   VENTAS_APP_PASSWORD='...' \
+--   ./scripts/bootstrap-roles.sh
+--
+-- Placeholders (no editar a mano en Render; usar el script):
+--   __DB_NAME__
+--   __VENTAS_MIGRATOR_PASSWORD__
+--   __VENTAS_APP_PASSWORD__
+--
+-- Alineado a la arquitectura multi-producto:
+--   - schema `ventas`
+--   - rol `ventas_migrator` (DDL / Flyway)
+--   - rol `ventas_app` (DML / API)
+--   - search_path = ventas (el schema NO va en la URL de conexión)
+
+CREATE SCHEMA IF NOT EXISTS ventas;
+
+DO $$
+BEGIN
+  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'ventas_migrator') THEN
+    CREATE ROLE ventas_migrator LOGIN PASSWORD '__VENTAS_MIGRATOR_PASSWORD__';
+  ELSE
+    ALTER ROLE ventas_migrator LOGIN PASSWORD '__VENTAS_MIGRATOR_PASSWORD__';
+  END IF;
+
+  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'ventas_app') THEN
+    CREATE ROLE ventas_app LOGIN PASSWORD '__VENTAS_APP_PASSWORD__';
+  ELSE
+    ALTER ROLE ventas_app LOGIN PASSWORD '__VENTAS_APP_PASSWORD__';
+  END IF;
+END
+$$;
+
+GRANT CONNECT ON DATABASE __DB_NAME__ TO ventas_migrator, ventas_app;
+
+GRANT USAGE, CREATE ON SCHEMA ventas TO ventas_migrator;
+GRANT USAGE ON SCHEMA ventas TO ventas_app;
+
+ALTER ROLE ventas_migrator SET search_path = ventas;
+ALTER ROLE ventas_app      SET search_path = ventas;
+
+-- Tablas/secuencias futuras creadas por el migrator → usables por la app
+ALTER DEFAULT PRIVILEGES FOR ROLE ventas_migrator IN SCHEMA ventas
+  GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO ventas_app;
+
+ALTER DEFAULT PRIVILEGES FOR ROLE ventas_migrator IN SCHEMA ventas
+  GRANT USAGE, SELECT ON SEQUENCES TO ventas_app;
+
+-- Por si ya existían objetos en el schema (re-runs)
+GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA ventas TO ventas_app;
+GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA ventas TO ventas_app;
+
+-- El migrator es dueño lógico del schema
+ALTER SCHEMA ventas OWNER TO ventas_migrator;
