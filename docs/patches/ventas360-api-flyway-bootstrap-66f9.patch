@@ -0,0 +1,30 @@
+#!/usr/bin/env bash
+# Crea schema `ventas` + roles ventas_migrator / ventas_app (idempotente).
+set -euo pipefail
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+TEMPLATE="${ROOT}/scripts/sql/01_bootstrap_roles_ventas.sql.template"
+
+DB_NAME="${DB_NAME:-ventas360}"
+ADMIN_URL="${ADMIN_DATABASE_URL:-postgresql://ventas360:ventas360@localhost:5433/${DB_NAME}}"
+VENTAS_MIGRATOR_PASSWORD="${VENTAS_MIGRATOR_PASSWORD:-ventas_migrator_dev}"
+VENTAS_APP_PASSWORD="${VENTAS_APP_PASSWORD:-ventas_app_dev}"
+
+if [[ ! -f "${TEMPLATE}" ]]; then
+  echo "No encuentro ${TEMPLATE}" >&2
+  exit 1
+fi
+
+TMP_SQL="$(mktemp)"
+trap 'rm -f "${TMP_SQL}"' EXIT
+
+# Sustituye placeholders sin tocar otras partes del SQL
+sed \
+  -e "s/__DB_NAME__/${DB_NAME}/g" \
+  -e "s/__VENTAS_MIGRATOR_PASSWORD__/${VENTAS_MIGRATOR_PASSWORD}/g" \
+  -e "s/__VENTAS_APP_PASSWORD__/${VENTAS_APP_PASSWORD}/g" \
+  "${TEMPLATE}" > "${TMP_SQL}"
+
+echo "→ Bootstrap roles en ${DB_NAME} (${ADMIN_URL%%@*}@…)"
+psql "${ADMIN_URL}" -v ON_ERROR_STOP=1 -f "${TMP_SQL}"
+echo "✓ Roles ventas_migrator / ventas_app listos (search_path=ventas)"
