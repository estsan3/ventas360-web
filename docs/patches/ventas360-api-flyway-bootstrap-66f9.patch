@@ -0,0 +1,23 @@
+-- V1__baseline.sql
+--
+-- Baseline Flyway del producto Ventas (schema `ventas`).
+--
+-- Decisión de naming (PR-A):
+--   Las tablas de negocio CONSERVAN el prefijo de módulo
+--   (`ventas_pedido`, `productos_producto`, …) y vivirán DENTRO del
+--   schema Postgres `ventas` (queda `ventas.ventas_pedido`).
+--   Motivo: cero churn de ORM/`__tablename__`/seeds en este PR.
+--   Cutover DDL: PRs siguientes mueven CREATE TABLE desde
+--   SQLAlchemy create_all hacia migraciones Flyway.
+--
+-- Este V1 solo marca el schema como gestionado por Flyway.
+-- create_all de la app SIGUE activo en dev; no se apaga aquí.
+
+CREATE TABLE _flyway_baseline (
+    id          smallint PRIMARY KEY DEFAULT 1 CHECK (id = 1),
+    nota        text        NOT NULL DEFAULT 'baseline ventas — DDL de negocio pendiente de cutover',
+    aplicado_en timestamptz NOT NULL DEFAULT now()
+);
+
+COMMENT ON TABLE _flyway_baseline IS
+  'Marcador de baseline Flyway. No usar en la app. Eliminar en el cutover DDL.';
