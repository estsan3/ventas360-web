+++ b/flyway/conf/flyway.conf
@@ -0,0 +1,22 @@
+# Flyway — producto Ventas360 (schema Postgres `ventas`)
+#
+# Se ejecuta con WORKDIR de la imagen oficial (/flyway): sql montado en
+# /flyway/sql → locations=filesystem:sql
+#
+# Reglas:
+# - flyway.schemas=ventas → flyway_schema_history vive DENTRO del schema
+# - SQL sin prefijo de schema (CREATE TABLE foo, no ventas.foo)
+# - Corre en pre-deploy (Render), no dentro del proceso HTTP de la app
+# - Sin undo (feature paga)
+
+flyway.locations=filesystem:sql
+flyway.schemas=ventas
+flyway.defaultSchema=ventas
+flyway.createSchemas=true
+flyway.baselineOnMigrate=false
+flyway.validateOnMigrate=true
+
+# Defaults locales (docker compose db en :5433). Override con -url/-user/-password.
+flyway.url=jdbc:postgresql://localhost:5433/ventas360
+flyway.user=ventas_migrator
+flyway.password=ventas_migrator_dev
