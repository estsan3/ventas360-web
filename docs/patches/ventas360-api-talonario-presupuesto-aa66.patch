+@pytest.mark.asyncio
+async def test_listar_talonarios_acepta_presupuesto_sembrado(cliente, auth_headers) -> None:
+    """El seed de casuística inserta tipo presupuesto; el GET no debe 500."""
+    from app.core.database import fabrica_sesiones
+    from app.core.tenant_ctx import usando_tenant
+    from app.modulos.parametros.models import Talonario
+    from app.modulos.tenants.ids import ID_TENANT_DEMO
+
+    async with fabrica_sesiones() as sesion:
+        with usando_tenant(ID_TENANT_DEMO):
+            sesion.add(
+                Talonario(
+                    id="tal-presupuesto",
+                    tipo_comprobante="presupuesto",
+                    prefijo="PRE-",
+                    proximo_numero=100,
+                )
+            )
+            await sesion.commit()
+
+    lista = await cliente.get("/api/v1/parametros/talonarios", headers=auth_headers)
+    assert lista.status_code == 200, lista.text
+    assert any(t["tipo_comprobante"] == "presupuesto" for t in lista.json())
+
+    tal = await cliente.put(
+        "/api/v1/parametros/talonarios",
+        headers=auth_headers,
+        json={
+            "tipo_comprobante": "presupuesto",
+            "prefijo": "PRE-",
+            "proximo_numero": 101,
+            "activo": True,
+        },
+    )
+    assert tal.status_code == 200, tal.text
+    assert tal.json()["proximo_numero"] == 101
+
+
