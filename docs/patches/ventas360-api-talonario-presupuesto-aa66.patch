 app/modulos/parametros/schemas.py   |  2 +-
 scripts/seed_casuistica.py          |  1 +
 tests/test_api_reporteria_fase_a.py | 38 +++++++++++++++++++++++++++++
 tests/test_bo_parametros.py         |  4 +++
 5 files changed, 45 insertions(+), 2 deletions(-)

diff --git a/app/modulos/parametros/bo.py b/app/modulos/parametros/bo.py
