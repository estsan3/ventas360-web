--- a/app/modulos/parametros/schemas.py
+++ b/app/modulos/parametros/schemas.py
@@ -4,7 +4,7 @@ from typing import Literal
 
 from pydantic import BaseModel, Field
 
-TipoComprobanteTalonario = Literal["pedido", "remito", "factura"]
+TipoComprobanteTalonario = Literal["presupuesto", "pedido", "remito", "factura"]
 CondicionIvaEmisor = Literal["responsable_inscripto", "monotributo", "exento"]
 
 
