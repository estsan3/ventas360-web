--- a/app/modulos/parametros/bo.py
+++ b/app/modulos/parametros/bo.py
@@ -4,7 +4,7 @@ import re
 
 from app.core.excepciones import ReglaDeNegocioViolada
 
-TIPOS_TALONARIO = {"pedido", "remito", "factura"}
+TIPOS_TALONARIO = {"presupuesto", "pedido", "remito", "factura"}
 CONDICIONES_IVA_EMISOR = {"responsable_inscripto", "monotributo", "exento"}
 _CUIT_DIGITOS = re.compile(r"^\d{11}$")
 
diff --git a/app/modulos/parametros/schemas.py b/app/modulos/parametros/schemas.py
